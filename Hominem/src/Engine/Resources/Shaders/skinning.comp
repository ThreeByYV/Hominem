#version 460 core

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly  buffer BoneMatrices  { mat4           u_Bones[];    };
layout(std430, binding = 1) readonly  buffer InPositions   { vec4           u_InPos[];    };
layout(std430, binding = 2) readonly  buffer InNormals     { vec4           u_InNorm[];   };
struct VertexBoneData { ivec4 BoneIDs; vec4 Weights; };
layout(std430, binding = 3) readonly  buffer InBoneData    { VertexBoneData u_BoneData[]; };
layout(std430, binding = 4) writeonly buffer OutPositions  { vec4           u_OutPos[];   };
layout(std430, binding = 5) writeonly buffer OutNormals    { vec4           u_OutNorm[];  };

uniform uint u_VertexCount;

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= u_VertexCount) return;

    VertexBoneData bd = u_BoneData[i];

    mat4 skin = u_Bones[bd.BoneIDs.x] * bd.Weights.x
              + u_Bones[bd.BoneIDs.y] * bd.Weights.y
              + u_Bones[bd.BoneIDs.z] * bd.Weights.z
              + u_Bones[bd.BoneIDs.w] * bd.Weights.w;

    u_OutPos[i]  = skin * u_InPos[i];
    u_OutNorm[i] = vec4(mat3(skin) * u_InNorm[i].xyz, 0.0);
}
