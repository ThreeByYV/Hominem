#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

#include "include/ddgi_common.glsl"
#include "include/scene_common.glsl"

layout(local_size_x = 64) in;

struct SphereInstance
{
    vec4 positionRadius;
    vec4 color;
};
layout(buffer_reference, std430) writeonly buffer SurfelBuffer
{
    SphereInstance surfels[];
};

struct Vertex
{
    float px, py, pz;
    float nx, ny, nz;
    float u, v;
    float tx, ty, tz, tw;
};
layout(buffer_reference, std430) readonly buffer VertexBuffer { Vertex vertices[]; };
layout(buffer_reference, std430) readonly buffer IndexBuffer  { uint   indices[];  };

struct InstanceGeom
{
    VertexBuffer vertices;
    IndexBuffer  indices;
    vec4         baseColor;
};
layout(buffer_reference, std430) readonly buffer InstanceGeomBuffer { InstanceGeom instances[]; };

layout(set = 0, binding = 0) uniform accelerationStructureEXT u_Tlas;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D u_RayData;
layout(set = 0, binding = 2) uniform sampler2D u_IrradianceAtlas;
layout(set = 0, binding = 3) uniform sampler2D u_DistanceAtlas;

layout(push_constant) uniform PushConstants
{
    vec4  u_Origin;
    vec4  u_Spacing;
    ivec4 u_Counts;   // xyz = counts, w = numRays
    vec4  u_Rotation; // quaternion (x,y,z,w)
    ivec4 u_Tiles;    // x = irradiance interior, y = distance interior
    SurfelBuffer       u_Surfels;
    InstanceGeomBuffer u_Instances;
    SceneBuffer        u_Scene;
    float u_SurfelRadius;
    float u_MaxRayDistance;
};

// Direct lighting only. DDGI's own indirect term (previous-frame irradiance sampled
// at the hit) is what fills shadows, so a flat ambient here would double-count the
// very constant the probe field exists to replace.
vec3 shadeSurface(vec3 worldPos, vec3 normal, vec3 albedo)
{
    vec3 color = vec3(0.0);
    for (int i = 0; i < SCENE_LIGHT_COUNT; i++)
    {
        vec3  toLight = u_Scene.lightPos[i].xyz - worldPos;
        float dist    = length(toLight);
        vec3  L       = toLight / max(dist, 0.0001);

        float radius = u_Scene.lightPos[i].w;
        float window = clamp(1.0 - pow(dist / radius, 4.0), 0.0, 1.0);
        float atten  = (window * window) / (dist * dist + 1.0);

        float NdotL = max(dot(normal, L), 0.0);
        color += albedo * u_Scene.lightColor[i].rgb * u_Scene.lightColor[i].w * NdotL * atten;
    }
    return color;
}

void main()
{
    int numRays   = u_Counts.w;
    int numProbes = u_Counts.x * u_Counts.y * u_Counts.z;
    int idx       = int(gl_GlobalInvocationID.x);
    if (idx >= numProbes * numRays) return;

    int probeIndex = idx / numRays;
    int rayIndex   = idx % numRays;

    DDGIVolume v;
    v.origin   = u_Origin;
    v.spacing  = u_Spacing;
    v.counts   = u_Counts;
    v.rotation = u_Rotation;
    v.tiles    = ivec4(0);

    vec3 probePos = ddgiProbeWorldPosition(probeIndex, v);
    vec3 dir      = ddgiProbeRayDirection(rayIndex, v);

    rayQueryEXT q;
    rayQueryInitializeEXT(q, u_Tlas, gl_RayFlagsOpaqueEXT, 0xFF, probePos, 0.001, dir, u_MaxRayDistance);
    while (rayQueryProceedEXT(q)) {}

    vec3  radiance   = vec3(0.0);
    float storedDist = u_MaxRayDistance; // miss: full range
    bool  hit        = false;

    if (rayQueryGetIntersectionTypeEXT(q, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
    {
        hit             = true;
        float hitDist   = rayQueryGetIntersectionTEXT(q, true);

        int  inst = rayQueryGetIntersectionInstanceCustomIndexEXT(q, true);
        int  prim = rayQueryGetIntersectionPrimitiveIndexEXT(q, true);
        vec2 bary = rayQueryGetIntersectionBarycentricsEXT(q, true);

        InstanceGeom g = u_Instances.instances[inst];
        uint i0 = g.indices.indices[prim * 3 + 0];
        uint i1 = g.indices.indices[prim * 3 + 1];
        uint i2 = g.indices.indices[prim * 3 + 2];

        Vertex a = g.vertices.vertices[i0];
        Vertex b = g.vertices.vertices[i1];
        Vertex c = g.vertices.vertices[i2];
        vec3 n0 = vec3(a.nx, a.ny, a.nz);
        vec3 n1 = vec3(b.nx, b.ny, b.nz);
        vec3 n2 = vec3(c.nx, c.ny, c.nz);
        float bw = 1.0 - bary.x - bary.y;
        vec3 nObj = normalize(bw * n0 + bary.x * n1 + bary.y * n2);

        mat3 worldToObject = mat3(rayQueryGetIntersectionWorldToObjectEXT(q, true));
        vec3 nWorld = normalize(nObj * worldToObject);

        bool backface = dot(nWorld, dir) > 0.0;
        if (backface)
        {
            // Probe likely sees the inside of geometry. Exclude from irradiance and
            // record a shortened negative distance so Chebyshev pulls the wall closer.
            radiance   = vec3(0.0);
            storedDist = -hitDist * 0.2;
        }
        else
        {
            vec3 hitPos = probePos + dir * hitDist;
            vec3 albedo = g.baseColor.rgb;

            vec3 direct = shadeSurface(hitPos, nWorld, albedo);

            vec3 bias   = nWorld * (0.25 * (u_Spacing.x + u_Spacing.y + u_Spacing.z) / 3.0);
            DDGIVolume vs = v;
            vs.tiles = u_Tiles;
            // The recursion: sample last frame's atlas (already holds N-1 bounces); x albedo = one more bounce.
            vec3 bounce = albedo * ddgiSampleIrradiance(hitPos, nWorld, bias,
                                                        u_Tiles.x, u_Tiles.y, vs,
                                                        u_IrradianceAtlas, u_DistanceAtlas);

            radiance   = direct + bounce;
            storedDist = hitDist;
        }
    }

    // Blend folds this into the atlas that next frame's trace samples — closes the feedback loop.
    imageStore(u_RayData, ivec2(rayIndex, probeIndex), vec4(radiance, storedDist));

    SphereInstance surfel;
    if (hit)
    {
        surfel.positionRadius = vec4(probePos + dir * abs(storedDist), u_SurfelRadius);
        surfel.color          = vec4(radiance, 1.0);
    }
    else
    {
        surfel.positionRadius = vec4(probePos, 0.0);
        surfel.color          = vec4(0.0);
    }
    u_Surfels.surfels[idx] = surfel;
}
