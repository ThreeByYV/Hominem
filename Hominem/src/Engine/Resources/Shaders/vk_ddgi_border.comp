#version 460

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0, rgba16f) uniform image2D u_Atlas;

layout(push_constant) uniform PushConstants
{
    ivec4 u_Counts; // xyz = probe counts
    ivec4 u_Tiles;  // x = interior size
};

// Octahedral border copy: each border texel mirrors the interior texel it wraps to,
// so bilinear sampling across a tile edge stays continuous.
void main()
{
    ivec2 texel    = ivec2(gl_GlobalInvocationID.xy);
    int   interior = u_Tiles.x;
    int   full     = interior + 2;

    int   perSlice  = u_Counts.x * u_Counts.z;
    ivec2 atlasSize = ivec2(perSlice, u_Counts.y) * full;
    if (texel.x >= atlasSize.x || texel.y >= atlasSize.y) return;

    ivec2 tile  = texel / full;
    ivec2 local = texel - tile * full;

    bool edgeX = (local.x == 0 || local.x == full - 1);
    bool edgeY = (local.y == 0 || local.y == full - 1);
    if (!edgeX && !edgeY) return; // interior texel, written by the blend pass

    ivec2 src;
    if (edgeX && edgeY)
        src = ivec2(local.x == 0 ? interior : 1, local.y == 0 ? interior : 1);
    else if (edgeY)
        src = ivec2(full - 1 - local.x, local.y == 0 ? 1 : interior);
    else
        src = ivec2(local.x == 0 ? 1 : interior, full - 1 - local.y);

    imageStore(u_Atlas, texel, imageLoad(u_Atlas, tile * full + src));
}
